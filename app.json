{
  "expo": {
    "name": "Vibexa",
    "slug": "vibe-exchange",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vibexa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "bundleIdentifier": "com.joker19.vibeexchange",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.joker19.vibeexchange",
      "runtimeVersion": "1.0.0"
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/appstore.png"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 23,
            "javaCompileOptions": {
              "sourceCompatibility": "17",
              "targetCompatibility": "17"
            },
            "kotlinVersion": "1.9.24"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "updates": {
      "url": "https://u.expo.dev/d2a62090-9d8f-41a1-ac32-574dfbdf3c4f"
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "d2a62090-9d8f-41a1-ac32-574dfbdf3c4f"
      }
    },

    "owner": "joker19"
  }
}
